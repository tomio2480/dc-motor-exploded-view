{
  "name": "dc-motor-exploded-view",
  "version": "0.1.0",
  "private": true,
  "description": "小型 DC モーターの 3D 展開図を表示する Web サイト",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "generate:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
